# Yumma configuration. Copy to .env for your own notes; the server reads real environment
# variables (Render, Terminal export), never this file. Every value below is optional for
# the local demo: with nothing set, Yumma runs on its deterministic rules on 127.0.0.1:4173.

# --- Live AI risk signal (optional). The AI may only RAISE caution, never lower it or authorise.
ANTHROPIC_API_KEY=            # e.g. sk-ant-...  (or use OPENAI_API_KEY instead)
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
YUMMA_RISK_TIMEOUT_MS=4000    # AI answers slower than this are ignored; the rules decide
YUMMA_AI_DAILY_CAP=2000       # AI calls per UTC day; after that the rules carry on alone
YUMMA_AI_RISK=                # set to "off" to disable the AI signal even when a key is present

# --- Hosted judge build (Render). Leave unset for local use.
YUMMA_JUDGE_MODE=             # "on" = access link, private synthetic profile per judge, proxy-aware limits
JUDGE_ACCESS_CODE=            # 16+ letters and digits; the judge link is https://<host>/?access=<code>
HOST=                         # defaults to 127.0.0.1 locally, 0.0.0.0 in judge mode
PORT=4173
YUMMA_DATA_DIR=               # where synthetic stores and the decision record live (default ./data)
YUMMA_LOG_TRACES=             # "off" to stop printing execution traces to the server log
